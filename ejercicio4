// --- Ejercicio 4: Menú de Operaciones Matemáticas ---
function calculadora(numero1, numero2, operacion) {
    let resultado;

    switch (operacion) {
        case "suma":
            resultado = numero1 + numero2;
            console.log(numero1 + " + " + numero2 + " = " + resultado);
            break; 
            
        case "resta":
            resultado = numero1 - numero2;
            console.log(numero1 + " - " + numero2 + " = " + resultado);
            break;
            
        case "multiplicacion":
            resultado = numero1 * numero2;
            console.log(numero1 + " * " + numero2 + " = " + resultado);
            break;
            
        case "division":
            if (numero2 === 0) {
                console.log("Error: No se puede dividir entre cero.");
            } else {
                resultado = numero1 / numero2;
                console.log(numero1 + " / " + numero2 + " = " + resultado);
            }
            break;
            
        default:
            console.log("Operación no válida. Usa: 'suma', 'resta', 'multiplicacion' o 'division'.");
            break;
    }
}

calculadora(10, 5, "suma");           // Debería dar 15
calculadora(10, 5, "resta");          // Debería dar 5
calculadora(10, 5, "multiplicacion"); // Debería dar 50
calculadora(10, 5, "division");       // Debería dar 2
calculadora(10, 0, "division");       // Prueba de error por dividir entre cero
calculadora(10, 5, "potencia");       // Prueba de error por palabra incorrecta
